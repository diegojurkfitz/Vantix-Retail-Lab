# Copie para terraform.tfvars e ajuste se necessário.
# NÃO comitar o terraform.tfvars real (está no .gitignore).
# Nenhum segredo deve ser colocado aqui.

aws_region         = "us-east-1"
aws_profile        = "terraform-lab"
allowed_account_id = "473247068706"

project     = "vantix-retail-cloud-lab"
environment = "lab"
owner       = "cloud-architecture"
purpose     = "technical-test"

vpc_cidr          = "10.0.0.0/16"
subnet_cidr       = "10.0.1.0/24"
availability_zone = "us-east-1a"

log_retention_days = 1
